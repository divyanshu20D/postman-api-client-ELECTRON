{
  "name": "reqkit",
  "version": "0.5.0",
  "private": true,
  "description": "ReqKit is a local-first desktop API client built with Electron, React, TypeScript, SQLite, and Drizzle.",
  "main": "dist-electron/index.js",
  "author": "Divyanshu Srivastava",
  "scripts": {
    "postinstall": "npm run rebuild:native",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsup src/main/index.ts src/main/preload.ts --format cjs --out-dir dist-electron --target node22 --external electron --watch --sourcemap",
    "dev:electron": "wait-on tcp:5173 dist-electron/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsup src/main/index.ts src/main/preload.ts --format cjs --out-dir dist-electron --target node22 --external electron --sourcemap",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^37.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.reqkit.app",
    "productName": "ReqKit",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "forceCodeSigning": false
  }
}
