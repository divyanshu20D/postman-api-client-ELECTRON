{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@db/*": ["src/db/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["vite.config.ts", "drizzle.config.ts", "src/main", "src/shared", "src/db", "src/modules"]
}
